[
  {
    "battery": {
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-full": "󰁹 100%",
      "format-icons": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "format-plugged": "󰚥 {capacity}%",
      "interval": 5,
      "states": {
        "critical": 10,
        "warning": 30
      }
    },
    "clock": {
      "actions": {
        "on-click-right": "shift_reset",
        "on-scroll-down": "shift_up",
        "on-scroll-up": "shift_down"
      },
      "calendar": {
        "format": {
          "today": "<span color='#a3be8c'><b><u>{}</u></b></span>",
          "weekdays": "<span color='#88c0d0'><b>{}</b></span>"
        },
        "mode": "month"
      },
      "format": "{:%H:%M}",
      "tooltip": true,
      "tooltip-format": "{calendar}"
    },
    "custom/separator": {
      "format": "|",
      "interval": "once",
      "tooltip": false
    },
    "custom/version": {
      "exec": "nixos-version",
      "format": "  {}",
      "interval": 3600,
      "tooltip": false
    },
    "height": 24,
    "hyprland/workspaces": {
      "active-only": false,
      "all-outputs": false,
      "format": "{icon}",
      "format-icons": {
        "1": "一",
        "2": "二",
        "3": "三",
        "4": "四",
        "5": "五",
        "6": "六",
        "7": "七",
        "8": "八",
        "9": "九",
        "10": "十"
      },
      "sort-by": "id"
    },
    "layer": "bottom",
    "load": {
      "format": "󰯱 {load1}",
      "interval": 5
    },
    "memory": {
      "format": "󰰏 {percentage}%",
      "interval": 5
    },
    "modules-left": [
      "hyprland/workspaces",
      "custom/separator",
      "custom/version"
    ],
    "modules-right": [
      "privacy",
      "tray",
      "custom/separator",
      "load",
      "memory",
      "temperature",
      "custom/separator",
      "network",
      "wireplumber",
      "battery",
      "custom/separator",
      "clock"
    ],
    "network": {
      "format-disconnected": "󰖪 ",
      "format-ethernet": "󰈁",
      "format-icons": [
        "󰤯 ",
        "󰤟 ",
        "󰤢 ",
        "󰤥 ",
        "󰤨 "
      ],
      "format-wifi": "{icon}",
      "interval": 5,
      "nospacing": 1,
      "tooltip-format-disconnected": "Disconnected",
      "tooltip-format-ethernet": "󰈁 {ifname}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
      "tooltip-format-wifi": "{icon} {essid}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}"
    },
    "position": "bottom",
    "privacy": {
      "icon-size": 12,
      "icon-spacing": 6,
      "modules": [
        {
          "tooltip-icon-size": 12,
          "type": "screenshare"
        },
        {
          "tooltip-icon-size": 12,
          "type": "audio-in"
        }
      ],
      "transition-duration": 250
    },
    "spacing": 6,
    "temperature": {
      "critical-threshold": 80,
      "format": " {temperatureC}°C",
      "format-critical": " {temperatureC}°C",
      "interval": 5,
      "thermal-zone": 2,
      "tooltip": false
    },
    "tray": {
      "spacing": 6,
      "icon-size": 12
    },
    "wireplumber": {
      "format": "{icon} {volume}%",
      "format-icons": {
        "car": "󰄋",
        "default": "󰕾",
        "hands-free": "󰥰",
        "hdmi": "󰍹",
        "headphone": "󰋋",
        "headset": "󰋎",
        "phone": "󰏲",
        "portable": "󰏲",
        "speaker": "󰕾"
      },
      "format-muted": "󰝟 {volume}%",
      "on-click": "volumectl mute",
      "on-click-right": "ghostty -e wiremix"
    }
  }
]
